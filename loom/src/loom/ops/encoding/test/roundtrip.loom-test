// RUN: roundtrip

// Exact encoding predicates carry the complete queried specification as a
// typed template parameter and infer the i1 result.
func.def @exact_static_spec_query(%schema: encoding<schema>) -> (i1) {
  %is_q4 = encoding.isa<#ggml.q4_0> %schema : encoding<schema>
  func.return %is_q4 : i1
}

// ====

// Fixed families use the same exact predicate without an empty parameter list.
func.def @exact_fixed_spec_query(%layout: encoding<layout>) -> (i1) {
  %is_dense = encoding.isa<#encoding.layout.dense> %layout : encoding<layout>
  func.return %is_dense : i1
}

// ====

// Encoding selection is an ordinary compile-time configuration value and does
// not enter the kernel workload or argument ABI.
config.decl @model.weight_encoding : encoding<schema>

func.def @config_driven_spec_query() -> (i1) {
  %schema = config.get @model.weight_encoding : encoding<schema>
  %is_q4 = encoding.isa<#ggml.q4_0> %schema : encoding<schema>
  func.return %is_q4 : i1
}

// ====

// Semantic predicates carry typed partial requirements. Omitted fields are
// wildcards, and the result type remains implicit.
func.def @semantic_schema_query(%schema: encoding<schema>) -> (i1) {
  %supports = encoding.matches<element_format = u4, payload_packing = multi_stream, affine = scale_plus_min> %schema : encoding<schema>
  func.return %supports : i1
}

// ====

// Dynamic encoding parameters are named SSA operands on encoding.define.
func.def @dynamic_encoding_params(%layout: encoding<layout>, %schema: encoding<schema>) {
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  test.use %storage : encoding<storage>
  func.return
}

// ====

// The resulting encoding value is attached explicitly in shaped types.
func.def @dynamic_encoding_attachment(%buffer: buffer, %offset: offset, %layout: encoding<layout>, %schema: encoding<schema>) {
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %view = buffer.view %buffer[%offset] : buffer -> view<256xi8, %storage>
  test.use %view : view<256xi8, %storage>
  func.return
}

// ====

// Multidimensional scale groups are logical schema structure; physical scale
// tensor padding and swizzling remain in the enclosing storage layout.
func.def @multidimensional_scale_group() {
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=256, payload_packing=separate_scale_payload, scale_format=f8e4m3fn, scale_group_shape=[16, 16], scale_operands=1, scale_topology=block_2d> : encoding<schema>
  test.use %schema : encoding<schema>
  func.return
}

// ====

// Layout assumptions are explicit SSA refinements for block/function argument
// layout values whose concrete layout was not locally constructed.
func.def @layout_assumptions(%layout: encoding<layout>) {
  %dense = encoding.layout.assume.dense %layout : encoding<layout>
  %strided = encoding.layout.assume.strided %layout {rank = 2} : encoding<layout>
  test.use %dense : encoding<layout>
  test.use %strided : encoding<layout>
  func.return
}

// ====

// Exact static-spec assumptions let dispatch thunks specialize schema/storage
// arguments without changing the original ABI value.
func.def @static_spec_assumption(%schema: encoding<schema>) {
  %schema2 = encoding.assume.spec %schema, #ggml.q4_0 : encoding<schema>
  test.use %schema2 : encoding<schema>
  func.return
}

// ====

// Semantic assumptions use the same typed requirement surface as matches and
// leave omitted facts unchanged.
func.def @semantic_match_assumption(%schema: encoding<schema>) {
  %schema2 = encoding.assume.match<element_format = u4, affine = scale_plus_min> %schema : encoding<schema>
  test.use %schema2 : encoding<schema>
  func.return
}

// ====

// Block-floating exponents are part of the encoded payload, not auxiliary SSA
// scales. The numerical format and conversion policy survive serialization.
func.def @block_float_schema() -> (encoding<schema>) {
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  func.return %schema : encoding<schema>
}
