// RUN: emit low-allocation-json @predicate_after_max

// Predicate storage is reusable after the fixed comparison write.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @predicate_after_max(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %maximum = max.s8x64 %left, %right
  %predicate = vlt.s8x64 %maximum, %right
  %selected = vsel.8 %maximum, %right, %predicate
  return %selected
}

