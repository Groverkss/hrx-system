// Fused integer reductions consume their first accumulator through the native
// result tie. Ordinary copies preserve values shared with later operations.
// RUN: with-low-asm pass low-cse,low-dce

low.func.def target<amd.xdna.aie2p.core> @fused_reduction(%left: reg<aie2p.vec256 x4>, %right: reg<aie2p.vec256 x2>, %first_accumulator: reg<aie2p.mbms x4>, %second_accumulator: reg<aie2p.mbms x4>, %mode: reg<aie2p.er>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %working = copy %first_accumulator : reg<aie2p.mbms x4> -> reg<aie2p.mbms x4>
  %first = maddmac.integer.y-x %working, %second_accumulator, %left, %right, %mode
  %next = copy %first : reg<aie2p.mbms x4> -> reg<aie2p.mbms x4>
  %second = maddmsc.integer.y-x %next, %first_accumulator, %left, %right, %mode
  return %first, %second
}

// ====

// RUN: verify

low.func.def target<amd.xdna.aie2p.core> @consumed_accumulator(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>, %accumulator: reg<aie2p.mbms x4>, %addend: reg<aie2p.mbms x4>, %mode: reg<aie2p.er>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %result = maddmac.integer.x-x %accumulator, %addend, %left, %right, %mode
  // ERROR@+1: DOMINANCE/002 {value_name="accumulator"}
  return %accumulator, %result
}

// ====

// Accumulator controls are value inputs: equal reductions merge while changes
// to the mode or arithmetic operation remain independently observable.
// RUN: with-low-asm pass low-cse,low-dce

low.func.def target<amd.xdna.aie2p.core> @accumulator_modes(%left: reg<aie2p.mbms x4>, %right: reg<aie2p.mbms x4>, %mode0: reg<aie2p.er>, %mode1: reg<aie2p.er>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %sum = vadd.acc.integer %left, %right, %mode0
  %repeated = vadd.acc.integer %left, %right, %mode0
  %other_mode = vadd.acc.integer %left, %right, %mode1
  %difference = vsub.acc.integer %left, %right, %mode0
  %negative = vneg.acc.integer %left, %mode0
  return %sum, %repeated, %other_mode, %difference, %negative
}

// ----
low.func.def target<amd.xdna.aie2p.core> @accumulator_modes(%left: reg<aie2p.mbms x4>, %right: reg<aie2p.mbms x4>, %mode0: reg<aie2p.er>, %mode1: reg<aie2p.er>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %sum = vadd.acc.integer %left, %right, %mode0
  %other_mode = vadd.acc.integer %left, %right, %mode1
  %difference = vsub.acc.integer %left, %right, %mode0
  %negative = vneg.acc.integer %left, %mode0
  return %sum, %sum, %other_mode, %difference, %negative
}
