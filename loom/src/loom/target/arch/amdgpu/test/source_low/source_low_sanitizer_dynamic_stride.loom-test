  %75 = flat_load_u8 %74 {glc = 1, dlc = 1}
  s_waitcnt {vmcnt = 0}
  %77 = v_and_b32_lit %51, 7
  %78 = v_add_u32_lit %77, 3
  %79 = v_cmp_ne_i32 %75, %27
  %80 = v_cmp_ge_u32 %75, %28
  %81 = v_cmp_ge_u32 %78, %75
  %82 = s_and_b64 %79, %81
  %83 = s_or_b64 %80, %82
  %84 = v_mov_b32 3
