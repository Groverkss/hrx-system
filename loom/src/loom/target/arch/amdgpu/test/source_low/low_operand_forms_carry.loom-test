// ====

// The low sum is dead, but its unsigned carry contributes to the returned word.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @high_word_only(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %step = s_mov_b32 3
  %zero = s_mov_b32 0
  %sum_low, %carry = s_add_co_u32 %low, %step
  %sum_high, %carry_out = s_addc_u32 %high, %zero, %carry
  return %sum_high
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @high_word_only(%low: reg<amdgpu.sgpr>, %high: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %zero = s_mov_b32 0
  %sum_low, %carry = s_add_co_u32_rhs_inline %low, 3
  %sum_high, %carry_out = s_addc_u32 %high, %zero, %carry
  return %sum_high
}

// ====

// Both the carry chain and ordinary arithmetic disappear when their values die.
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dead_carry_chain(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  %low, %carry = s_add_co_u32 %lhs, %rhs
  %high, %carry_out = s_addc_u32 %lhs, %rhs, %carry
  %ordinary = s_add_u32 %lhs, %rhs
  return %lhs
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @dead_carry_chain(%lhs: reg<amdgpu.sgpr>, %rhs: reg<amdgpu.sgpr>) -> (reg<amdgpu.sgpr>) asm {
  return %lhs
}
