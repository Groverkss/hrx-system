// Hidden state reads are reusable until their class is written. A write to
// another class must preserve the single-class read and expire the pair.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @selective_state_classes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %special_before = test.state.read.i32 %value
  %pair_before = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %special_after = test.state.read.i32 %value
  %pair_after = test.state.read_pair.i32 %value
  %pair_copy = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %special_final = test.state.read.i32 %value
  %pair_final = test.state.read_pair.i32 %value
  return %special_after, %pair_copy, %special_final, %pair_final
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @selective_state_classes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %special_before = test.state.read.i32 %value
  %pair_before = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %pair_after = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %special_final = test.state.read.i32 %value
  %pair_final = test.state.read_pair.i32 %value
  return %special_before, %pair_after, %special_final, %pair_final
}

// ====

// Upfront CFG scopes inherit state memberships when their parent executes,
// not when scopes are allocated. Empty intermediate scopes forward the map.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_through_empty_scopes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %special = test.state.read.i32 %value
  %pair = test.state.read_pair.i32 %value
  low.br ^bridge
^finish:
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %special_copy = test.state.read.i32 %value
  %pair_after = test.state.read_pair.i32 %value
  return %special_copy, %pair_after
^bridge:
  low.br ^next_bridge
^next_bridge:
  low.br ^finish
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_through_empty_scopes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %special = test.state.read.i32 %value
  %pair = test.state.read_pair.i32 %value
  low.br ^bridge
^finish:
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %pair_after = test.state.read_pair.i32 %value
  return %special, %pair_after
^bridge:
  low.br ^next_bridge
^next_bridge:
  low.br ^finish
}

// ====

// Writes expire shared ancestors, but not sibling-local definitions. The right
// subtree's write must preserve reuse in the left finish block; a global state
// epoch would lose that reuse.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @sibling_state_snapshots(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) asm {
  %outer = test.state.read.i32 %value
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %left_write = test.state.add.i32 %value, %value
  %left_value = test.state.read.i32 %value
  low.br ^left_finish
^right:
  %right_write = test.state.add.i32 %value, %value
  %right_value = test.state.read.i32 %value
  low.br ^right_finish
^left_finish:
  %left_copy = test.state.read.i32 %value
  return %left_copy
^right_finish:
  %right_copy = test.state.read.i32 %value
  return %right_copy
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @sibling_state_snapshots(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) asm {
  %outer = test.state.read.i32 %value
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %left_write = test.state.add.i32 %value, %value
  %left_value = test.state.read.i32 %value
  low.br ^left_finish
^right:
  %right_write = test.state.add.i32 %value, %value
  %right_value = test.state.read.i32 %value
  low.br ^right_finish
^left_finish:
  return %left_value
^right_finish:
  return %right_value
}

// ====

// The pair expires through one class, then its slot is reused by another
// insertion. The second class must still reach the newly registered pair,
// rather than treating a reused slot as an already-expired membership.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_membership_epochs(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %before = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %middle = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %after = test.state.read_pair.i32 %value
  %special = test.state.read.i32 %value
  %next_schedule_write = test.state.add.schedule_state %schedule, %schedule
  %special_copy = test.state.read.i32 %value
  %last = test.state.read_pair.i32 %value
  %last_copy = test.state.read_pair.i32 %value
  return %special_copy, %last_copy
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_membership_epochs(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %before = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %middle = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %after = test.state.read_pair.i32 %value
  %special = test.state.read.i32 %value
  %next_schedule_write = test.state.add.schedule_state %schedule, %schedule
  %last = test.state.read_pair.i32 %value
  return %special, %last
}

// ====
// A join cuts off older mutable-state candidates without hiding pure ones.
// Its straight-line descendant can reuse the new read below that boundary.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @join_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  low.br ^join
^right:
  low.br ^join
^join:
  %joined_read = test.load.v4i32 %pointer
  %joined_bias = test.const.i32 7
  low.br ^finish
^finish:
  %final_read = test.load.v4i32 %pointer
  %final_bias = test.const.i32 7
  return %final_read, %final_bias
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @join_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  low.br ^join
^right:
  low.br ^join
^join:
  %joined_read = test.load.v4i32 %pointer
  low.br ^finish
^finish:
  return %joined_read, %bias
}

// ====

// A loop's backedge also cuts off older reads. The loop-local candidate is
// visible to its body and exit, while pure candidates remain visible above it.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @backedge_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.br ^header
^header:
  %loop_read = test.load.v4i32 %pointer
  %loop_bias = test.const.i32 7
  low.cond_br %condition, ^body, ^finish : reg<test.i32>
^body:
  %body_read = test.load.v4i32 %pointer
  low.br ^header
^finish:
  %final_read = test.load.v4i32 %pointer
  %final_bias = test.const.i32 7
  return %final_read, %final_bias
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @backedge_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.br ^header
^header:
  %loop_read = test.load.v4i32 %pointer
  low.cond_br %condition, ^body, ^finish : reg<test.i32>
^body:
  low.br ^header
^finish:
  return %loop_read, %bias
}
