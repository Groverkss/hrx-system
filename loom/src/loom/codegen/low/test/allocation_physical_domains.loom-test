// RUN: emit low-allocation-json @loop_initializer_keeps_future_domain_available

test.target<low_core> @target

// The initializer ends before the restricted value starts. Its loop affinity
// carries the state lifetime back to the initial physical choice.
low.func.def target<test.low.core>(@target) @loop_initializer_keeps_future_domain_available(%condition: reg<test.i32>) -> (reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %initial = test.const.explicit32 1
  low.br ^loop(%initial: reg<test.explicit32>)
^loop(%state: reg<test.explicit32>):
  %restricted = test.const.packed.narrow 7
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%state: reg<test.explicit32>)
^exit:
  return %state, %restricted
}

