// RUN: emit low-allocation-json @equal_restricted_domains_remain_preferred

test.target<low_core> @target

// Both producers can already occupy their consumer's domain. Equal-domain
// competitors require distinct registers, not an intermediate broad register.
low.func.def target<test.low.core>(@target) @equal_restricted_domains_remain_preferred(%first: reg<test.explicit32>, %second: reg<test.explicit32>) -> (reg<test.packed.narrow>, reg<test.packed.narrow>) asm {
  %narrow_first = copy %first : reg<test.explicit32> -> reg<test.packed.narrow>
  %narrow_second = copy %second : reg<test.explicit32> -> reg<test.packed.narrow>
  return %narrow_first, %narrow_second
}

