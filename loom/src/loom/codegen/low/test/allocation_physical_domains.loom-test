// RUN: emit low-allocation-json @semantic_candidates_use_physical_identity

test.target<low_core> @target

// packed.wide enumerates r0,r2,r1,r3. The partner domain is r2,r3, so the
// producer preference must translate physical IDs into its own ordinals.
low.func.def target<test.low.core>(@target) @semantic_candidates_use_physical_identity(%source: reg<test.packed.wide>) -> (reg<test.coindexed.partner>) asm {
  %result = copy %source : reg<test.packed.wide> -> reg<test.coindexed.partner>
  return %result
}

