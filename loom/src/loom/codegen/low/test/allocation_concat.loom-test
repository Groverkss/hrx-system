// RUN: emit low-allocation-json @reversed_physical_sources

test.target<low_core> @target

// The first source occupies the second unit of l0: physical r2, not r1.
low.func.def target<test.low.core>(@target) @reversed_physical_sources(%high: reg<test.explicit32>, %low: reg<test.explicit32>) -> (reg<test.explicit32 x2>) asm {
  %pair = concat(%low, %high) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  return %pair
}

