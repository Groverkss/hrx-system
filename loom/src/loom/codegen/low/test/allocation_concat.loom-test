// RUN: emit low-allocation-json @physical_concat_avoids_live_alias fixed=%blocker:physical_register:0:1

test.target<low_core> @target

// Live r0 excludes l0. The sources must assemble l1 from r1 and r3.
low.func.def target<test.low.core>(@target) @physical_concat_avoids_live_alias(%blocker: reg<test.explicit32>, %high: reg<test.explicit32>, %low: reg<test.explicit32>) -> (reg<test.explicit32 x2>, reg<test.explicit32>) asm {
  %pair = concat(%low, %high) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  return %pair, %blocker
}

