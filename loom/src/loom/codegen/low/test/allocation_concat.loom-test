low.func.def target<test.low.core>(@target) @physical_concat_broadcast_source(%value: reg<test.explicit32>) -> (reg<test.explicit32 x2>) asm {
  %pair = concat(%value, %value) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  return %pair
}

